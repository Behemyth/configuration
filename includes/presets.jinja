{#-
  Build identities rendered into the per-platform CMake presets.

  Each identity produces:
    - `<identity>`: Ninja Multi-Config configure preset (CI, CLI, and Visual
      Studio users who pick the configuration at build time), with build and
      test presets `<identity>-multi-<configuration>`.
    - `<identity>-<configuration>`: single-configuration Ninja presets for
      Visual Studio Open Folder and VS Code CMake Tools; configure, build, and
      test presets share the name.

  This file sits outside `_subdirectory`, so Copier never copies it.
-#}
{%- set configurations = ["Debug", "Development", "Release"] -%}

{%- set platforms = {
	"windows": {
		"prefix": "windows",
		"host": "Windows",
		"description": "Windows",
		"warnings": "/W4",
		"development_compile": "/O2 /Ob2",
		"development_link": "/DEBUG /INCREMENTAL:NO /OPT:REF /OPT:ICF",
	},
	"linux": {
		"prefix": "linux",
		"host": "Linux",
		"description": "Linux",
		"warnings": "-Wall -Wextra -Wpedantic",
		"development_compile": "-O2 -g",
		"development_link": "",
	},
	"mac": {
		"prefix": "macos",
		"host": "Darwin",
		"description": "macOS",
		"warnings": "-Wall -Wextra -Wpedantic",
		"development_compile": "-O2 -g",
		"development_link": "",
	},
} -%}

{%- set libcxx_link = "-stdlib=libc++" -%}
{%- set libcxx_mac_link = "-stdlib=libc++ -L$env{LLVM_ROOT}/lib/c++ -Wl,-rpath,$env{LLVM_ROOT}/lib/c++ -L$env{LLVM_ROOT}/lib/unwind -lunwind" -%}
{%- set sanitize_compile = "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer" -%}
{%- set sanitize_link = "-fsanitize=address,undefined" -%}

{%- set identities = [
	{
		"name": "windows-x64-msvc",
		"platform": "windows",
		"display": "Windows x64 MSVC",
		"architecture": "x64",
		"c": "cl",
		"cxx": "cl",
		"cxx_flags": "",
		"link_flags": "",
		"intellisense": "windows-msvc-x64",
	},
	{
		"name": "windows-arm64-msvc",
		"platform": "windows",
		"display": "Windows arm64 MSVC",
		"architecture": "arm64",
		"c": "cl",
		"cxx": "cl",
		"cxx_flags": "",
		"link_flags": "",
		"intellisense": "windows-msvc-arm64",
	},
	{
		"name": "linux-x64-clang-libcxx",
		"platform": "linux",
		"display": "Linux x64 Clang libc++",
		"c": "$env{LLVM_ROOT}/bin/clang",
		"cxx": "$env{LLVM_ROOT}/bin/clang++",
		"cxx_flags": "-stdlib=libc++",
		"link_flags": libcxx_link,
		"intellisense": "linux-clang-x64",
	},
	{
		"name": "linux-arm64-clang-libcxx",
		"platform": "linux",
		"display": "Linux arm64 Clang libc++",
		"c": "$env{LLVM_ROOT}/bin/clang",
		"cxx": "$env{LLVM_ROOT}/bin/clang++",
		"cxx_flags": "-stdlib=libc++",
		"link_flags": libcxx_link,
		"intellisense": "linux-clang-arm64",
	},
	{
		"name": "linux-x64-clang-libcxx-sanitize",
		"platform": "linux",
		"display": "Linux x64 Clang libc++ ASan UBSan",
		"c": "$env{LLVM_ROOT}/bin/clang",
		"cxx": "$env{LLVM_ROOT}/bin/clang++",
		"c_flags": sanitize_compile,
		"cxx_flags": "-stdlib=libc++ " ~ sanitize_compile,
		"link_flags": libcxx_link ~ " " ~ sanitize_link,
		"intellisense": "linux-clang-x64",
	},
	{
		"name": "macos-arm64-clang-libcxx",
		"platform": "mac",
		"display": "macOS arm64 Clang libc++",
		"c": "$env{LLVM_ROOT}/bin/clang",
		"cxx": "$env{LLVM_ROOT}/bin/clang++",
		"cxx_flags": "-stdlib=libc++",
		"link_flags": libcxx_mac_link,
		"intellisense": "macos-clang-arm64",
	},
] -%}

{%- macro join_flags(first, second) -%}
{{ (first ~ " " ~ second) | trim }}
{%- endmacro -%}

{%- macro platform_presets(key) -%}
{%- set platform = platforms[key] -%}
{%- set base = platform.prefix ~ "-default" -%}
{%- set host_condition -%}
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "{{ platform.host }}"
			}
{%- endset -%}
{
	"version": 10,
	"include": [
		"../common/CMakePresets.json"
	],
	"configurePresets": [
		{
			"name": "{{ base }}",
			"hidden": true,
			"description": "Base preset for {{ platform.description }} identities",
			"inherits": [
				"default"
			],
{{ host_condition }}
{%- if key == "windows" %},
			"cacheVariables": {
				"CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "${sourceDir}/tool/cmake/platform/common/SetMSVCRuntime.cmake",
				"CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "$<$<CONFIG:Debug,Development>:ProgramDatabase>"
			}
{%- endif %}
		},
		{
			"name": "{{ base }}-development",
			"hidden": true,
			"description": "Development configuration: optimized with debug info and assertions, Release ABI and dependencies",
			"cacheVariables": {
{%- if key == "windows" %}
				"CMAKE_C_FLAGS_DEVELOPMENT": "{{ platform.development_compile }}",
				"CMAKE_CXX_FLAGS_DEVELOPMENT": "{{ platform.development_compile }}",
{%- else %}
				"CMAKE_C_FLAGS_DEVELOPMENT": "{{ platform.development_compile }}",
				"CMAKE_CXX_FLAGS_DEVELOPMENT": "{{ platform.development_compile }} -D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_EXTENSIVE",
{%- endif %}
{%- if platform.development_link %}
				"CMAKE_EXE_LINKER_FLAGS_DEVELOPMENT": "{{ platform.development_link }}",
				"CMAKE_SHARED_LINKER_FLAGS_DEVELOPMENT": "{{ platform.development_link }}",
				"CMAKE_MODULE_LINKER_FLAGS_DEVELOPMENT": "{{ platform.development_link }}",
{%- endif %}
				"CMAKE_MAP_IMPORTED_CONFIG_DEVELOPMENT": "Release"
			}
		}
{%- for identity in identities if identity.platform == key %},
		{
			"name": "{{ identity.name }}-toolchain",
			"hidden": true,
			"description": "Compiler and flags for {{ identity.display }}",
			"inherits": [
				"{{ base }}"
			],
{%- if identity.get("architecture") %}
			"architecture": {
				"value": "{{ identity.get("architecture") }}",
				"strategy": "external"
			},
{%- endif %}
			"cacheVariables": {
				"CMAKE_C_COMPILER": "{{ identity.c }}",
				"CMAKE_CXX_COMPILER": "{{ identity.cxx }}",
				"CMAKE_C_FLAGS_INIT": "{{ join_flags(platform.warnings, identity.get("c_flags", "")) }}",
				"CMAKE_CXX_FLAGS_INIT": "{{ join_flags(platform.warnings, identity.cxx_flags) }}"
{%- if identity.link_flags %},
				"CMAKE_EXE_LINKER_FLAGS_INIT": "{{ identity.link_flags }}",
				"CMAKE_SHARED_LINKER_FLAGS_INIT": "{{ identity.link_flags }}",
				"CMAKE_MODULE_LINKER_FLAGS_INIT": "{{ identity.link_flags }}"
{%- endif %}
			},
			"vendor": {
				"microsoft.com/VisualStudioSettings/CMake/1.0": {
					"intelliSenseMode": "{{ identity.intellisense }}"
				}
			}
		},
		{
			"name": "{{ identity.name }}",
			"displayName": "{{ identity.display }}",
			"description": "Ninja Multi-Config: choose Debug, Development, or Release when building",
			"generator": "Ninja Multi-Config",
			"binaryDir": "${sourceDir}/build/{{ identity.name }}/multi",
			"inherits": [
				"cppython",
				"{{ identity.name }}-toolchain",
				"{{ base }}-development"
			],
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": "{{ configurations | join(';') }}"
			}
		}
{%- for configuration in configurations %},
		{
			"name": "{{ identity.name }}-{{ configuration | lower }}",
			"displayName": "{{ identity.display }} {{ configuration }}",
			"description": "Ninja single-config {{ configuration }} build",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/{{ identity.name }}/{{ configuration | lower }}",
			"inherits": [
				"{{ 'cppython-debug' if configuration == 'Debug' else 'cppython-release' }}",
				"{{ identity.name }}-toolchain"{% if configuration == 'Development' %},
				"{{ base }}-development"{% endif %}
			],
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "{{ configuration }}"
			}
		}
{%- endfor %}
{%- endfor %}
	],
	"buildPresets": [
		{
			"name": "{{ base }}",
			"hidden": true,
			"inherits": [
				"default"
			],
{{ host_condition }}
		}
{%- for identity in identities if identity.platform == key %}
{%- for configuration in configurations %},
		{
			"name": "{{ identity.name }}-multi-{{ configuration | lower }}",
			"displayName": "{{ identity.display }} {{ configuration }}",
			"configurePreset": "{{ identity.name }}",
			"configuration": "{{ configuration }}",
			"inherits": [
				"{{ base }}"
			]
		},
		{
			"name": "{{ identity.name }}-{{ configuration | lower }}",
			"displayName": "{{ identity.display }} {{ configuration }}",
			"configurePreset": "{{ identity.name }}-{{ configuration | lower }}",
			"inherits": [
				"{{ base }}"
			]
		}
{%- endfor %}
{%- endfor %}
	],
	"testPresets": [
		{
			"name": "{{ base }}",
			"hidden": true,
			"inherits": [
				"default"
			],
{{ host_condition }}
		}
{%- for identity in identities if identity.platform == key %}
{%- for configuration in configurations %},
		{
			"name": "{{ identity.name }}-multi-{{ configuration | lower }}",
			"displayName": "{{ identity.display }} {{ configuration }}",
			"configurePreset": "{{ identity.name }}",
			"configuration": "{{ configuration }}",
			"inherits": [
				"{{ base }}"
			]
		},
		{
			"name": "{{ identity.name }}-{{ configuration | lower }}",
			"displayName": "{{ identity.display }} {{ configuration }}",
			"configurePreset": "{{ identity.name }}-{{ configuration | lower }}",
			"inherits": [
				"{{ base }}"
			]
		}
{%- endfor %}
{%- if use_benchmarks %},
		{
			"name": "{{ identity.name }}-bench",
			"displayName": "{{ identity.display }} Bench",
			"configurePreset": "{{ identity.name }}-release",
			"inherits": [
				"default-bench",
				"{{ base }}"
			]
		}
{%- endif %}
{%- endfor %}
	]
}
{% endmacro -%}
