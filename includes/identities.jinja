		"configurations": configurations,
		"architecture": "x64",
		"c": "cl",
		"cxx": "cl",
		"cxx_flags": "",
		"link_flags": "",
		"intellisense": "windows-msvc-x64",
	},
	{
		"name": "windows-arm64-msvc",
		"platform": "windows",
		"arch": "arm64",
		"compiler": "msvc",
		"standard_library": "msvc",
		"display": "Windows arm64 MSVC",
		"configurations": configurations,
		"architecture": "arm64",
		"c": "cl",
		"cxx": "cl",
		"cxx_flags": "",
		"link_flags": "",
		"intellisense": "windows-msvc-arm64",
	},
	{
		"name": "linux-x64-clang-libcxx",
		"platform": "linux",
		"arch": "x64",
		"compiler": "clang",
		"standard_library": "libc++",
		"display": "Linux x64 Clang libc++",
