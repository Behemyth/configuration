{
	"version": 10,
	"include": [
		"../common/CMakePresets.json"
	],
	"configurePresets": [
		{
			"name": "windows-default",
			"inherits": [
				"default"
			],
			"hidden": true,
			"description": "Base preset for Windows configurations",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			},
			"architecture": {
				"value": "x64",
				"strategy": "external"
			},
			"cacheVariables": {
				"CMAKE_C_FLAGS_INIT": "/W4",
				"CMAKE_CXX_FLAGS_INIT": "/W4",
				"CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "${sourceDir}/tool/cmake/platform/common/SetMSVCRuntime.cmake"
			}
		},
		{
			"name": "windows-ninja-msvc",
			"displayName": "Ninja MSVC",
			"description": "Ninja Multi-Config generator with Microsoft Visual C++ (MSVC)",
			"generator": "Ninja Multi-Config",
			"inherits": [
				"windows-default"
			],
			"cacheVariables": {
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl"
			},
			"vendor": {
				"microsoft.com/VisualStudioSettings/CMake/1.0": {
					"intelliSenseMode": "windows-msvc-x64"
				}
			}
		},
		{
			"name": "windows-ninja-clang",
			"displayName": "Ninja Clang",
			"description": "Ninja Multi-Config generator with Clang (clang-cl)",
			"generator": "Ninja Multi-Config",
			"inherits": [
				"windows-default"
			],
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang-cl",
				"CMAKE_CXX_COMPILER": "clang-cl"
			},
			"vendor": {
				"microsoft.com/VisualStudioSettings/CMake/1.0": {
					"intelliSenseMode": "windows-clang-x64"
				}
			}
		},
		{
			"name": "windows-msbuild-msvc",
			"displayName": "MSBuild MSVC",
			"description": "Visual Studio 18 2026 generator with Microsoft Visual C++ (MSVC)",
			"generator": "Visual Studio 18 2026",
			"architecture": {
				"value": "x64",
				"strategy": "set"
			},
			"inherits": [
				"windows-default"
			]
		},
		{
			"name": "windows-msbuild-clang",
			"displayName": "MSBuild Clang",
			"description": "Visual Studio 18 2026 generator with Clang (clang-cl)",
			"generator": "Visual Studio 18 2026",
			"architecture": {
				"value": "x64",
				"strategy": "set"
			},
			"inherits": [
				"windows-default"
			],
			"toolset": "ClangCL"
		},
		{
			"name": "windows-ninja-msvc-release",
			"inherits": [
				"cppython-release",
				"windows-ninja-msvc"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Release"
				}
			}
		},
		{
			"name": "windows-ninja-msvc-development",
			"inherits": [
				"cppython-release",
				"windows-ninja-msvc"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Development"
				},
				"CMAKE_MAP_IMPORTED_CONFIG_DEVELOPMENT": {
					"type": "STRING",
					"value": "Release"
				}
			}
		},
		{
			"name": "windows-ninja-msvc-debug",
